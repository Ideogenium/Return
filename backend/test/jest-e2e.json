{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.+)\\.js$": "$1",
    "^expo-server-sdk$": "<rootDir>/__mocks__/expo-server-sdk.ts"
  }
}
