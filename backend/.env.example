# =============================================================================
# Return API — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://return:return_dev@localhost:5432/return_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:8081

# Push notifications (Expo Push Service — CORR-13 option B)
# Optionnel : ne sert qu'à lever le rate-limit anonyme (~1000 notifs/h).
EXPO_ACCESS_TOKEN=
# Cloudflare R2 (photo storage)
# Toutes renseignées → R2 ; toutes vides → stockage disque local (dev).
# Obligatoires en production (NODE_ENV=production) : l'app refuse de démarrer sans.
# Une configuration partielle est refusée au démarrage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Overdue job (FEAT-10: ACTIVE -> AWAITING_RETURN -> NOT_RETURNED)
# Opt-in : le job ne tourne que si la valeur est exactement "true" (sinon il logge "skipped").
# NOT_RETURNED est irréversible : en prod, déployer coupé, compter, puis activer.
OVERDUE_JOB_ENABLED=true
# Lot : max de prêts traités par étape et par passage (entier > 0, défaut 100).
# Le reste est repris au passage suivant.
OVERDUE_JOB_BATCH_SIZE=100
# Disjoncteur : si les candidats d'une étape dépassent cette part des prêts ouverts
# (]0, 1], défaut 0.5) ET le lot, l'étape n'écrit rien et logge une erreur.
OVERDUE_JOB_MAX_SHARE=0.5
